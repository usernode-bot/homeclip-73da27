{
  "description": "Watch your homeroom's own serial drama together",
  "icon": {
    "emoji": "📺"
  },
  "secrets": [
    {
      "key": "STRIPE_SECRET_KEY",
      "description": "Stripe SECRET key in TEST (sandbox) mode, starts with sk_test_. Get it from dashboard.stripe.com, Developers, API keys, with test mode on. Leave empty to show the VIP page without checkout.",
      "required": false,
      "private": true
    },
    {
      "key": "STRIPE_WEBHOOK_SECRET",
      "description": "Stripe TEST-mode webhook signing secret (starts with whsec_) for the endpoint /api/webhooks/stripe. Optional: checkout also confirms on return from Stripe.",
      "required": false,
      "private": true
    },
    {
      "key": "PAYMENT_PROVIDER",
      "description": "Which payment provider checkout uses: stripe (sandbox, implemented), midtrans or xendit (adapters structured, not built yet).",
      "required": false,
      "default": "stripe",
      "private": false
    }
  ],
  "governance": {
    "preset": "you_or_the_group"
  },
  "tests": [
    {
      "id": "home.feed",
      "name": "Home renders the drama feed",
      "path": "/",
      "expectText": "Staging demo: Harbour Lights"
    },
    {
      "id": "home.detail",
      "name": "Drama detail renders seasons and episodes",
      "path": "/dramas/staging-demo-harbour-lights",
      "expectText": "Season 1"
    },
    {
      "id": "search.screen",
      "name": "Search opens with its field",
      "path": "/search",
      "expectSelector": "input[data-search]"
    },
    {
      "id": "search.results",
      "name": "Search finds a seeded drama",
      "path": "/search?q=harbour",
      "expectText": "Staging demo: Harbour Lights"
    },
    {
      "id": "player.screen",
      "name": "Player opens a seeded episode",
      "path": "/watch/900003",
      "expectSelector": "video"
    },
    {
      "id": "add.screen",
      "name": "Add a drama form renders",
      "path": "/add",
      "expectText": "Add a drama"
    },
    {
      "id": "phase2.profiles-and-continue",
      "name": "Profiles, search and continue watching",
      "path": "/profiles",
      "expectSelector": "input[data-profile-id], [data-first], .avatar",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "server/**",
        "styles/**",
        "dapp.json"
      ]
    },
    { "name": "Feed empty state", "path": "/", "expectText": "No dramas yet" },
    { "id": "demo-feed", "name": "Populated demo", "path": "/?demo=1", "expectText": "The Tide Table", "visual": true, "impact": ["public/**", "styles/**"] },
    { "name": "Watch screen", "path": "/watch/9000012?demo=1", "expectText": "The Tide Table" },
    { "name": "Watch screen without video", "path": "/watch/9000004?demo=1", "expectText": "No video here yet" },
    { "name": "Downloads upsell", "path": "/downloads", "expectText": "Downloads are for VIP" },
    { "name": "Downloads demo VIP", "path": "/downloads?demo=1", "expectText": "No downloads yet" },
    { "name": "Drama page meta", "path": "/drama/900001?demo=1", "expectSelector": "meta[property='og:title']" },
    { "name": "Legal pages up", "path": "/terms", "expectText": "Terms of Service" },
    { "id": "home-rows", "name": "Home browse rows", "path": "/?demo=1", "expectText": "Trending Now", "visual": true, "impact": ["public/**", "styles/**", "server.js"] },
    { "id": "sample-drama-page", "name": "Sample drama page with episodes", "path": "/?demo=1#/drama/910001", "expectText": "The Undelivered Tray", "visual": true, "impact": ["public/**", "styles/**", "server.js"] },
    { "name": "Drama page", "path": "/?demo=1#/drama/900001", "expectText": "Season 2" },
    { "id": "drama-reviews", "name": "Drama page with reviews", "path": "/?demo=1#/drama/900001", "expectText": "3 reviews", "visual": true, "impact": ["public/**", "styles/**", "server.js", "moderation.js"] },
    { "id": "episode-comments", "name": "Episode sheet comments", "path": "/?demo=1#/drama/900001?ep=9000005", "expectText": "Comments", "visual": true, "impact": ["public/**", "styles/**", "server.js", "moderation.js"] },
    { "id": "drama-no-reviews", "name": "Drama page without reviews", "path": "/?demo=1#/drama/900003", "expectText": "No reviews yet" },
    { "id": "vip.page", "name": "VIP page with IDR plans", "path": "/#/vip", "expectText": "Rp 59.000", "visual": true, "impact": ["public/**", "server.js", "styles/**", "providers/**"] },
    { "name": "Manage subscription renders", "path": "/#/vip/manage", "expectText": "Manage subscription" },
    { "name": "Payment history renders", "path": "/#/vip/payments", "expectText": "Payment history" }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  }
}
