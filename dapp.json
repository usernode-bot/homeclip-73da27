{
  "description": "Watch your homeroom's own serial drama together",
  "icon": {
    "emoji": "📺"
  },
  "secrets": [
    {
      "key": "STRIPE_SECRET_KEY",
      "description": "Stripe SECRET key in TEST (sandbox) mode, starts with sk_test_. Get it from dashboard.stripe.com, Developers, API keys, with test mode on. Leave empty to show the VIP page without checkout.",
      "required": false,
      "private": true
    },
    {
      "key": "STRIPE_WEBHOOK_SECRET",
      "description": "Stripe TEST-mode webhook signing secret (starts with whsec_) for the endpoint /api/webhooks/stripe. Optional: checkout also confirms on return from Stripe.",
      "required": false,
      "private": true
    },
    {
      "key": "PAYMENT_PROVIDER",
      "description": "Which payment provider checkout uses: stripe (sandbox, implemented), midtrans or xendit (adapters structured, not built yet).",
      "required": false,
      "default": "stripe",
      "private": false
    }
  ],
  "governance": {
    "preset": "you_or_the_group"
  },
  "tests": [
    {
      "name": "Home renders (production shape)",
      "path": "/",
      "expectText": "Trending Now",
      "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "styles/**"]
    },
    { "id": "demo-feed", "name": "Tracker populated demo", "path": "/tracker?demo=1", "expectText": "The Tide Table", "visual": true, "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "styles/**"] },
    { "id": "home-rows", "name": "Tracker browse rows", "path": "/tracker?demo=1", "expectText": "Trending Now", "visual": true, "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "styles/**", "server.js"] },
    { "id": "sample-drama-page", "name": "Sample drama page with episodes", "path": "/tracker?demo=1#/drama/910001", "expectText": "The Undelivered Tray", "visual": true, "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "styles/**", "server.js"] },
    { "name": "Tracker feed empty state", "path": "/tracker", "expectText": "No dramas yet" },
    { "name": "Drama page", "path": "/tracker?demo=1#/drama/900001", "expectText": "Season 2" },
    { "id": "drama-reviews", "name": "Drama page with reviews", "path": "/tracker?demo=1#/drama/900001", "expectText": "3 reviews", "visual": true, "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "styles/**", "server.js", "moderation.js"] },
    { "id": "episode-comments", "name": "Episode sheet comments", "path": "/tracker?demo=1#/drama/900001?ep=9000005", "expectText": "Comments", "visual": true, "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "styles/**", "server.js", "moderation.js"] },
    { "id": "drama-no-reviews", "name": "Drama page without reviews", "path": "/tracker?demo=1#/drama/900003", "expectText": "No reviews yet" },
    { "id": "vip.page", "name": "VIP page with IDR plans", "path": "/tracker#/vip", "expectText": "Rp 59.000", "visual": true, "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "server.js", "styles/**", "providers/**"] },
    { "name": "Manage subscription renders", "path": "/tracker#/vip/manage", "expectText": "Manage subscription" },
    { "name": "Payment history renders", "path": "/tracker#/vip/payments", "expectText": "Payment history" }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  }
}
