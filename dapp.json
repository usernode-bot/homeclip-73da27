{
  "description": "Watch your homeroom's own serial drama together",
  "icon": {
    "emoji": "📺"
  },
  "secrets": [
    {
      "key": "STRIPE_SECRET_KEY",
      "description": "Stripe SECRET key in TEST (sandbox) mode, starts with sk_test_. Get it from dashboard.stripe.com, Developers, API keys, with test mode on. Leave empty to show the VIP page without checkout.",
      "required": false,
      "private": true
    },
    {
      "key": "STRIPE_WEBHOOK_SECRET",
      "description": "Stripe TEST-mode webhook signing secret (starts with whsec_) for the endpoint /api/webhooks/stripe. Optional: checkout also confirms on return from Stripe.",
      "required": false,
      "private": true
    },
    {
      "key": "PAYMENT_PROVIDER",
      "description": "Which payment provider checkout uses: stripe (sandbox, implemented), midtrans or xendit (adapters structured, not built yet).",
      "required": false,
      "default": "stripe",
      "private": false
    },
    {
      "key": "TMDB_API_KEY",
      "description": "TMDB API key (v3) from themoviedb.org, Settings, API. Used server-side only, to fetch verified drama metadata and posters for the Posters studio. Leave empty: the app works without it and the studio shows an honest notice instead of importing.",
      "required": false,
      "private": true
    }
  ],
  "governance": {
    "preset": "you_or_the_group"
  },
  "tests": [
    {
      "name": "Home renders (production shape)",
      "path": "/",
      "expectText": "Trending Now",
      "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "styles/**"]
    },
    { "id": "demo-feed", "name": "Tracker populated demo", "path": "/tracker?demo=1", "expectText": "The Tide Table", "visual": true, "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "styles/**"] },
    { "id": "home-rows", "name": "Tracker browse rows", "path": "/tracker?demo=1", "expectText": "Trending Now", "visual": true, "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "styles/**", "server.js"] },
    { "id": "sample-drama-page", "name": "Sample drama page with episodes", "path": "/tracker?demo=1#/drama/910001", "expectText": "The Undelivered Tray", "visual": true, "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "styles/**", "server.js"] },
    { "name": "Tracker feed empty state", "path": "/tracker", "expectText": "No dramas yet" },
    { "name": "Tracker watch screen", "path": "/tracker/watch/9000012?demo=1", "expectText": "The Tide Table" },
    { "name": "Tracker watch screen without video", "path": "/tracker/watch/9000004?demo=1", "expectText": "No video here yet" },
    { "name": "Tracker downloads upsell", "path": "/tracker#/downloads", "expectText": "Downloads are for VIP" },
    { "name": "Tracker downloads demo VIP", "path": "/tracker?demo=1#/downloads", "expectText": "No downloads yet" },
    { "name": "Tracker drama page meta", "path": "/tracker/drama/900001?demo=1", "expectSelector": "meta[property='og:title']" },
    { "name": "Legal pages up", "path": "/terms", "expectText": "Terms of Service" },
    { "name": "Drama page", "path": "/tracker?demo=1#/drama/900001", "expectText": "Season 2" },
    { "id": "drama-reviews", "name": "Drama page with reviews", "path": "/tracker?demo=1#/drama/900001", "expectText": "3 reviews", "visual": true, "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "styles/**", "server.js", "moderation.js"] },
    { "id": "episode-comments", "name": "Episode sheet comments", "path": "/tracker?demo=1#/drama/900001?ep=9000005", "expectText": "Comments", "visual": true, "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "styles/**", "server.js", "moderation.js"] },
    { "id": "drama-no-reviews", "name": "Drama page without reviews", "path": "/tracker?demo=1#/drama/900003", "expectText": "No reviews yet" },
    { "id": "vip.page", "name": "VIP page with IDR plans", "path": "/tracker#/vip", "expectText": "Rp 59.000", "visual": true, "impact": ["public/tracker.html", "public/app.js", "public/screens.css", "server.js", "styles/**", "providers/**"] },
    { "name": "Manage subscription renders", "path": "/tracker#/vip/manage", "expectText": "Manage subscription" },
    { "name": "Payment history renders", "path": "/tracker#/vip/payments", "expectText": "Payment history" },
    { "id": "profiles.screen", "name": "Profiles screen", "path": "/profiles", "expectText": "Add profile", "visual": true, "impact": ["public/js/views/profiles.js", "public/js/views/profile.js", "public/js/router.js", "styles/**", "server.js"] },
    { "id": "add.screen", "name": "Add a drama screen", "path": "/add", "expectText": "Add a drama", "expectSelector": "input[type='file'][accept='image/jpeg,image/png,image/webp']", "visual": true, "impact": ["public/js/views/add.js", "public/js/views/profile.js", "public/js/router.js", "styles/**"] },
    { "id": "home.play", "name": "Home banner Play button", "path": "/", "expectSelector": "[data-b-play]", "visual": true, "impact": ["public/js/views/home.js", "public/js/ui.js", "styles/**", "data/catalog.js"] },
    { "id": "home.carousel-arrows", "name": "Home rows have scroll arrows", "path": "/", "expectSelector": ".hc-carousel .hc-carousel-btn-next:not([disabled])", "visual": true, "impact": ["public/js/ui.js", "public/js/views/home.js", "styles/**", "data/catalog.js"] },
    { "name": "Discover cards carry the play badge", "path": "/discover", "expectSelector": ".hc-playbadge" },
    { "id": "player.play", "name": "Player renders with buffering spinner", "path": "/watch/2/1", "expectSelector": "[data-spinner]", "visual": true, "impact": ["public/js/views/player.js", "styles/**", "server.js", "data/catalog.js"] },
    { "id": "player.vip-paywall", "name": "Player paywall on a VIP episode", "path": "/watch/2/9", "expectText": "This episode is for VIP", "visual": true, "impact": ["public/js/views/player.js", "server.js", "data/catalog.js", "styles/**"] },
    { "id": "art.home", "name": "Home shows original artwork", "path": "/", "expectSelector": "img[src*='/img/poster/']", "visual": true, "impact": ["public/js/art.js", "public/js/ui.js", "public/js/views/home.js", "public/img/**", "styles/**"] },
    { "id": "home.series-row", "name": "Home Popular Series row", "path": "/?demo=1", "expectText": "Popular Series", "visual": true, "impact": ["server.js", "public/js/views/home.js", "public/js/ui.js", "public/js/art.js", "public/js/i18n.js", "styles/**"] },
    { "name": "Home Recently Added row", "path": "/?demo=1", "expectText": "Recently Added" },
    { "name": "Discover grid shows original posters", "path": "/discover", "expectSelector": "img[src*='/img/poster/']" },
    { "name": "Drama detail shows backdrop", "path": "/drama/1", "expectSelector": ".hc-backdrop img[src*='/img/backdrop/']", "expectText": "Paper Lanterns at Dusk" },
    { "name": "Episode list shows stills", "path": "/drama/1", "expectSelector": ".hc-still img[src*='/img/still/']" },
    { "name": "Profiles populated demo", "path": "/profiles?demo=1", "expectText": "Who's watching?" },
    { "id": "posters.studio", "name": "Poster studio renders", "path": "/posters", "expectText": "Poster search", "expectSelector": "input[type='search']", "visual": true, "impact": ["public/js/views/posters.js", "public/js/views/profile.js", "public/js/router.js", "public/js/i18n.js", "server.js", "providers/**"] },
    { "name": "Home demo shows short dramas", "path": "/?demo=1", "expectText": "Short dramas" },
    { "name": "Verified demo record shows its facts", "path": "/drama/9001?demo=1", "expectText": "Original title" },
    { "name": "Unverified record shows titled generated art", "path": "/drama/9003?demo=1", "expectSelector": "img[src*='/poster/9003.svg']", "expectText": "Metadata awaiting review" },
    { "name": "Flagged demo record keeps its verified facts", "path": "/drama/9004?demo=1", "expectText": "Metadata verified", "expectSelector": "img[src*='/img/demo/poster-9004.svg']", "allowConsoleErrors": true },
    { "id": "posters.scan", "name": "Studio artwork scan controls", "path": "/posters?demo=1", "expectText": "Check all artwork", "visual": true, "impact": ["server.js", "public/js/views/posters.js", "public/js/i18n.js"] },
    { "name": "Studio offers artwork replace", "path": "/posters?demo=1", "expectText": "Replace artwork" },
    { "name": "Studio lists records without artwork", "path": "/posters?demo=1", "expectText": "No artwork yet" }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  }
}
